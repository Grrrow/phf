---
import type { LocaleCode } from "../../i18n/config";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getAbsoluteAssetUrl } from "../../utils/urls";
import { getLocalizedPath } from "../../i18n/utils";

export interface Props {
  locale: LocaleCode;
  currentPath: string;
  globalConfig?: any;
  alternates?: { href: string; hreflang: string }[];
}

const { locale, currentPath, globalConfig, alternates = [] } = Astro.props;
const headerConfig = globalConfig?.header?.[0] || {};
const logoUrl = getAbsoluteAssetUrl(headerConfig?.logo?.filename);
const logoAlt = headerConfig?.logo_alt || "Pedro Halffter";
const brandText = headerConfig?.brand_text || "PEDRO HALFFTER";
const navigation = headerConfig?.navigation || [];
const showLanguageSwitcher = headerConfig?.show_language_switcher ?? true;
const stickyHeader = headerConfig?.sticky_header ?? true;
const isHome = currentPath === "/" || currentPath === "/es/" || currentPath === "/es" || currentPath === "";
---

<header class={`global-header ${stickyHeader ? "sticky" : ""}`}>
  <div class="header-container">
    <div class="logo">
      <a href={locale === "es" ? "/es/" : "/"}>
        {
          logoUrl ? (
            <img src={logoUrl} alt={logoAlt} />
          ) : (
            <span class="brand-text">{brandText}</span>
          )
        }
      </a>
    </div>


        <input type="checkbox" id="menu-toggle" class="menu-toggle" />
        <label
          for="menu-toggle"
          class="menu-button"
          aria-label="Abrir menú de navegación"
        >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </label>

        <nav class="main-nav" aria-label="Main Navigation">
          <ul>
            {
              navigation.map((item: any) => {
                let linkHref = "";
                if (item.link?.cached_url) {
                  if (item.link.cached_url.startsWith("http")) {
                    linkHref = item.link.cached_url;
                  } else {
                    const cleaned = item.link.cached_url
                      .split("/")
                      .filter(Boolean)
                      .join("/");
                    linkHref = cleaned ? `/${cleaned}/` : "/";
                  }
                } else {
                  linkHref = "#";
                }

                linkHref = getLocalizedPath(linkHref, locale);

                const normLink = linkHref.split("/").filter(Boolean).join("/");
                const normCurrent = currentPath
                  .split("/")
                  .filter(Boolean)
                  .join("/");
                const isActive =
                  normLink === ""
                    ? normCurrent === "" || normCurrent === "es"
                    : normCurrent === normLink;

                return (
                  <li>
                    <a
                      href={linkHref}
                      target={item.open_in_new_tab ? "_blank" : undefined}
                      rel={item.rel !== "none" ? item.rel : undefined}
                      class={isActive ? "active" : ""}
                      aria-current={isActive ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>


    <div class="header-actions">
      <div class="header-social-links">
        <a href="https://www.facebook.com/profile.php?id=100069814851042" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/pedrohalffter/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-icon-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
      </div>
      {
        showLanguageSwitcher && (
          <LanguageSwitcher
            currentLocale={locale}
            currentPath={currentPath}
            alternates={alternates}
          />
        )
      }
    </div>
  </div>
</header>

<style>
  .global-header {
    background-color: #ffffff;
    border-bottom: 1px solid #f5f5f5;
    width: 100%;
    z-index: 1000;
  }

  .global-header.sticky {
    position: sticky;
    top: 0;
  }

  .header-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 1.75rem 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  /* Logo styling */
  .logo a {
    text-decoration: none;
    color: #1a1a1a;
  }

  .brand-text {
    font-size: 1.1rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-family: inherit;
  }

  .logo img {
    height: 40px;
    width: auto;
    display: block;
  }

  /* Navigation centered */
  .main-nav {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .main-nav ul {
    list-style: none;
    display: flex;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
  }

  .main-nav a {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    text-decoration: none;
    color: #767676; /* gris inactivo */
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
    padding: 0.5rem 0;
    border-bottom: 1.5px solid transparent;
  }

  .main-nav a:hover,
  .main-nav a:focus {
    color: #1a1a1a;
  }

  .main-nav a.active {
    color: #cca43b; /* dorado/naranja suave */
    border-bottom-color: #cca43b; /* subrayado fino */
  }

  /* Right actions */
  .header-actions {
    display: flex;
    align-items: center;
  }

  .header-social-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-right: 1.75rem;
  }

  .social-icon-link {
    color: #555555;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .social-icon-link:hover {
    color: #111111;
    transform: scale(1.1);
  }

  /* Responsive & Hamburger menu */
  .menu-toggle {
    display: none;
  }

  .menu-button {
    display: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
    padding: 5px;
    z-index: 1010;
  }

  .hamburger-line {
    width: 22px;
    height: 1.5px;
    background-color: #1a1a1a;
    transition: all 0.3s ease;
  }

  @media (max-width: 1024px) {
    .header-container {
      padding: 1.25rem 2rem;
      justify-content: flex-start;
      gap: 1.5rem;
    }

    .logo {
      margin-right: auto;
    }

    .menu-button {
      display: flex;
    }

    .main-nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background-color: #ffffff;
      border-bottom: 1px solid #eaeaea;
      flex-direction: column;
      padding: 1.5rem 0;
      display: none;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
      z-index: 999;
    }

    .main-nav ul {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }

    .main-nav a {
      font-size: 0.8rem;
    }

    .menu-toggle:checked ~ .main-nav {
      display: flex;
    }

    /* Animate hamburger lines on toggle */
    .menu-toggle:checked ~ .menu-button .hamburger-line:nth-child(1) {
      transform: translateY(6.5px) rotate(45deg);
    }

    .menu-toggle:checked ~ .menu-button .hamburger-line:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle:checked ~ .menu-button .hamburger-line:nth-child(3) {
      transform: translateY(-6.5px) rotate(-45deg);
    }
  }

  @media (max-width: 480px) {
    .header-container {
      padding: 1rem 1.5rem;
    }

    .brand-text {
      font-size: 0.95rem;
      letter-spacing: 0.2em;
    }
  }
</style>
