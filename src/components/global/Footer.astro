---
import type { LocaleCode } from '../../i18n/config';
import { getAbsoluteAssetUrl } from '../../utils/urls';
import { getLocalizedPath } from '../../i18n/utils';

export interface Props {
  locale: LocaleCode;
  currentPath?: string;
  globalConfig?: any;
  alternates?: { href: string; hreflang: string }[];
}

const { locale, currentPath = '/', globalConfig } = Astro.props;
const footerConfig = globalConfig?.footer?.[0] || {};
const footerLogoUrl = getAbsoluteAssetUrl(footerConfig?.footer_logo?.filename);
const footerLogoAlt = footerConfig?.footer_logo_alt || 'Pedro Halffter';
const brandText = footerConfig?.brand_text || 'PEDRO HALFFTER';
const legalLinks = footerConfig?.legal_links || [];
const copyrightText = footerConfig?.copyright_text || `© ${new Date().getFullYear()} PEDRO HALFFTER. ALL RIGHTS RESERVED.`;
---
<footer class="global-footer-wrapper reveal-footer">
  <div class="footer-card">
    <div class="footer-content-container">
      <div class="footer-brand">
        {footerLogoUrl ? (
          <img src={footerLogoUrl} alt={footerLogoAlt} />
        ) : (
          <span class="brand-text">{brandText}</span>
        )}
      </div>
      
      <nav class="footer-nav" aria-label="Footer Navigation">
        <ul>
          {legalLinks.map((item: any) => {
            let linkHref = '#';
            if (item.link?.cached_url) {
              if (item.link.cached_url.startsWith('http')) {
                linkHref = item.link.cached_url;
              } else {
                const cleaned = item.link.cached_url.split('/').filter(Boolean).join('/');
                linkHref = cleaned ? `/${cleaned}/` : '/';
              }
            }
            linkHref = getLocalizedPath(linkHref, locale);
            return (
              <li>
                <a href={linkHref}>{item.label}</a>
              </li>
            );
          })}
        </ul>
      </nav>
      
      <div class="footer-social">
        <a href="https://www.facebook.com/profile.php?id=100069814851042" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="footer-social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>FACEBOOK</span>
        </a>
        <a href="https://www.instagram.com/pedrohalffter/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer-social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>INSTAGRAM</span>
        </a>
      </div>

      <div class="footer-copyright">
        <span>{copyrightText.toUpperCase()}</span>
      </div>
    </div>
  </div>
</footer>

<script>
  function initFooterObserver() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    const footer = document.querySelector('.reveal-footer');
    if (footer) observer.observe(footer);
  }

  initFooterObserver();
  document.addEventListener('astro:page-load', initFooterObserver);
</script>

<style>
  .global-footer-wrapper {
    background-color: #ffffff;
    border-top: 1px solid #f5f5f5;
    padding: 0;
    width: 100%;
    margin-top: 5rem;
  }
  
  /* Reveal Animation */
  .reveal-footer {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal-footer.revealed {
    opacity: 1;
    transform: translateY(0);
  }
  
  .footer-card {
    background-color: #ffffff;
    width: 100%;
    padding: 4rem 0;
    display: flex;
    justify-content: center;
  }

  .footer-content-container {
    max-width: 1440px;
    width: 100%;
    padding: 0 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  
  /* Left column: Brand text */
  .footer-brand .brand-text {
    font-size: 1rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #1a1a1a;
  }
  
  .footer-brand img {
    height: 35px;
    width: auto;
    display: block;
  }
  
  /* Center column: Nav links */
  .footer-nav ul {
    list-style: none;
    display: flex;
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: center;
  }
  
  .footer-nav a {
    font-size: 0.7rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    text-decoration: none;
    color: #8e9aa8; /* gris azulado suave */
    transition: color 0.3s ease;
  }
  
  .footer-nav a:hover,
  .footer-nav a:focus {
    color: #1a1a1a;
  }
  
  .footer-social {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin: 1.75rem 0 1rem 0;
  }

  .footer-social-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #666666;
    text-decoration: none;
    font-family: var(--font-sans, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .footer-social-link:hover {
    color: #111111;
    transform: translateY(-1px);
  }
  
  /* Right column: Copyright */
  .footer-copyright {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #1a1a1a; /* negro con mayor peso */
    text-align: right;
  }
  
  /* Mobile styling */
  @media (max-width: 900px) {
    .footer-card {
      padding: 3rem 0;
    }
    
    .footer-content-container {
      flex-direction: column;
      text-align: center;
      padding: 0 2rem;
      gap: 2.25rem;
    }
    
    .footer-nav ul {
      flex-direction: column;
      gap: 1.25rem;
      align-items: center;
    }
    
    .footer-copyright {
      text-align: center;
    }
  }
</style>
