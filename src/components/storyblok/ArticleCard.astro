---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;

const hasLink = blok.cta_link?.cached_url;
const linkUrl = hasLink ? (blok.cta_link.cached_url.startsWith('http') ? blok.cta_link.cached_url : `/${blok.cta_link.cached_url.replace(/^\/|\/$/g, '')}/`) : null;
const linkTarget = blok.open_in_new_tab ? '_blank' : '_self';
const linkRel = blok.open_in_new_tab ? 'noopener noreferrer' : undefined;

const isFeatured = blok.variant === 'featured';
const category = blok.category?.toUpperCase() || '';
const date = blok.date || '';
const mediaType = blok.media_type || 'image';
const hasMedia = mediaType !== 'none' && blok.image?.filename;

// Storyblok image optimization
function getOptimizedImageUrl(url: string, width: number, quality: number = 80) {
  if (!url) return '';
  return `${url}/m/${width}x0/filters:quality(${quality})`;
}

const defaultSrc = hasMedia ? getOptimizedImageUrl(blok.image.filename, isFeatured ? 900 : 500) : '';
const altText = blok.image_alt || blok.title || 'Article image';
const ctaLabel = blok.cta_label || 'READ FULL ARTICLE';

const CardWrapper = hasLink ? 'a' : 'div';
const wrapperProps = hasLink ? {
  href: linkUrl,
  target: linkTarget,
  rel: linkRel,
  class: 'article-card-inner'
} : {
  class: 'article-card-inner'
};
---

<article 
  {...storyblokEditable(blok)} 
  class={`article-card variant-${blok.variant || 'standard'}`}
  data-category={category}
>
  <CardWrapper {...wrapperProps}>
    
    {hasMedia && (
      <div class="card-media">
        <img 
          src={defaultSrc} 
          alt={altText} 
          loading="lazy" 
          class="media-image"
        />
        {mediaType === 'video' && (
          <div class="play-overlay" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="11" fill="rgba(0,0,0,0.4)" stroke="currentColor" stroke-width="1.5"/>
              <path d="M10 8L16 12L10 16V8Z" fill="currentColor"/>
            </svg>
          </div>
        )}
      </div>
    )}

    <div class="card-body">
      <div class="meta-row">
        {date && <span class="article-date">{date}</span>}
        {category && <span class="article-category">{category}</span>}
      </div>

      {blok.title && <h3 class="article-title">{blok.title}</h3>}
      {blok.excerpt && <p class="article-excerpt">{blok.excerpt}</p>}

      {hasLink && (
        <div class="card-footer">
          <span class="article-cta">
            {ctaLabel} <span class="arrow">&rarr;</span>
          </span>
        </div>
      )}
    </div>

  </CardWrapper>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .article-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* Media styling */
  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #EAEAEA;
  }

  .media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .article-card:hover .media-image {
    transform: scale(1.03);
  }

  .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    background: rgba(0, 0, 0, 0.15);
    transition: background 0.3s ease;
  }

  .article-card:hover .play-overlay {
    background: rgba(0, 0, 0, 0.25);
  }

  .placeholder-media {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #F0F0F0;
  }

  .placeholder-graphic {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid #CCC;
  }

  /* Body styling */
  .card-body {
    display: flex;
    flex-direction: column;
    padding-top: 1.5rem;
    flex-grow: 1;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-sans, sans-serif);
    font-size: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .article-date {
    color: var(--accent-slate, #767676);
  }

  .article-category {
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--accent-gold, #CBA052);
    text-transform: uppercase;
  }

  .article-title {
    font-family: var(--font-serif, serif);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.25;
    color: var(--primary, #111);
    margin: 0 0 0.75rem 0;
    transition: color 0.3s ease;
  }

  .article-card:hover .article-title {
    color: var(--accent-gold, #CBA052);
  }

  .article-excerpt {
    font-family: var(--font-sans, sans-serif);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--on-surface-variant, #555);
    margin: 0 0 1.25rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .article-cta {
    font-family: var(--font-sans, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--primary, #111);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.3s ease;
  }

  .article-cta .arrow {
    transition: transform 0.3s ease;
  }

  .article-card:hover .article-cta .arrow {
    transform: translateX(4px);
  }

  /* --- Variant: Featured (Hero 2-Column) --- */
  .variant-featured {
    grid-column: span 1;
  }

  @media (min-width: 900px) {
    .variant-featured {
      grid-column: span 2;
    }

    .variant-featured .article-card-inner {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    .variant-featured .card-media {
      aspect-ratio: 4 / 3;
      height: 100%;
    }

    .variant-featured .card-body {
      padding-top: 0;
      justify-content: center;
    }

    .variant-featured .article-title {
      font-size: 2.25rem;
      margin-bottom: 1.25rem;
    }

    .variant-featured .article-excerpt {
      font-size: 1rem;
      -webkit-line-clamp: 6;
      margin-bottom: 2rem;
    }
  }
</style>
