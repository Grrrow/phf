---
import { storyblokEditable } from '@storyblok/astro';
import StoryblokImage from '../media/StoryblokImage.astro';

const { blok } = Astro.props;

// Extract logic variables
const headingLevel = blok.heading_level || 'h1';
const imageTreatment = blok.image_treatment || 'black_white';
const isLcp = typeof blok.is_lcp === 'boolean' ? blok.is_lcp : true;

const TitleTag = headingLevel as any;
const isDecorative = blok.image_is_decorative === true;
const altText = isDecorative ? "" : (blok.image_alt || blok.title || "Pedro Halffter");

const hasImage = !!blok.image?.filename;
---

<section {...storyblokEditable(blok)} class="biography-hero-section">
  
  {hasImage && (
    <div class={`hero-image-wrapper treatment-${imageTreatment}`}>
      <StoryblokImage
        src={blok.image.filename}
        alt={altText}
        width={1920}
        height={1080}
        loading={isLcp ? 'eager' : 'lazy'}
        fetchpriority={isLcp ? 'high' : 'auto'}
        sizes="100vw"
        widths={[768, 1024, 1440, 1920, 2560]}
        class="hero-img"
      />
      <div class="hero-overlay"></div>
    </div>
  )}

  <div class="hero-content-container">
    <div class="hero-content">
      {blok.eyebrow && <span class="eyebrow">{blok.eyebrow}</span>}
      {blok.title && <TitleTag class="title">{blok.title}</TitleTag>}
      {blok.intro && <p class="intro">{blok.intro}</p>}
    </div>
  </div>

</section>

<style>
  .biography-hero-section {
    position: relative;
    width: 100%;
    min-height: 70vh;
    display: flex;
    align-items: center; /* Center vertically */
    justify-content: center;
    background-color: var(--primary, #111);
    overflow: hidden;
  }

  .hero-image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%; /* Keep focus on upper part for portraits */
  }

  /* Image Treatments */
  .treatment-black_white .hero-img {
    filter: grayscale(100%) contrast(1.1);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(17,17,17,0.9) 0%, rgba(17,17,17,0.6) 40%, rgba(17,17,17,0.3) 100%);
    z-index: 2;
  }

  .hero-content-container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: var(--container-max, 1200px);
    margin: 0 auto;
    padding: 8rem var(--margin-x, 1.5rem) 4rem var(--margin-x, 1.5rem);
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 800px;
    color: #FFFFFF;
  }

  .eyebrow {
    font-family: var(--font-sans, sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-gold, #CBA052);
    margin-bottom: 1.5rem;
  }

  .title {
    font-family: var(--font-serif, serif);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 400;
    line-height: 1.1;
    color: #FFFFFF;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.02em;
    text-shadow: 0 4px 20px rgba(0,0,0,0.6);
  }

  .intro {
    font-family: var(--font-serif, serif);
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    max-width: 650px;
  }

  /* Fade Up Animation */
  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-content > * {
    opacity: 0;
    animation: heroFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: opacity, transform;
  }

  .hero-image-wrapper {
    opacity: 0;
    animation: heroFadeUp 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: opacity, transform;
  }

  .eyebrow { animation-delay: 0.3s; }
  .title { animation-delay: 0.4s; }
  .intro { animation-delay: 0.5s; }
</style>
