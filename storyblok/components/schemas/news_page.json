{
  "component": {
    "name": "news_page",
    "display_name": "News Page",
    "is_nestable": false,
    "is_root": true,
    "schema": {
      "seo": {
        "type": "bloks",
        "pos": 0,
        "translatable": false,
        "maximum": 1,
        "restrict_components": true,
        "component_whitelist": [
          "seo"
        ],
        "description": "Configuración SEO de la página."
      },
      "title": {
        "type": "text",
        "pos": 1,
        "translatable": true,
        "default_value": "News & Media",
        "description": "Título principal H1 de la página (ej. 'News & Media')."
      },
      "categories": {
        "type": "text",
        "pos": 2,
        "translatable": true,
        "default_value": "ALL, INTERVIEWS, REVIEWS, MULTIMEDIA, ANNOUNCEMENTS",
        "description": "Categorías separadas por comas para generar las pestañas de filtro."
      },
      "featured_article": {
        "type": "bloks",
        "pos": 3,
        "translatable": false,
        "maximum": 1,
        "restrict_components": true,
        "component_whitelist": [
          "article_card"
        ],
        "description": "Artículo destacado principal que ocupará la cabecera (layout de 2 columnas)."
      },
      "articles": {
        "type": "bloks",
        "pos": 4,
        "translatable": false,
        "restrict_components": true,
        "component_whitelist": [
          "article_card"
        ],
        "description": "Lista de artículos en cuadrícula."
      },
      "load_more_label": {
        "type": "text",
        "pos": 5,
        "translatable": true,
        "default_value": "LOAD MORE ARTICLES",
        "description": "Texto del botón de cargar más artículos."
      },
      "page_theme": {
        "type": "option",
        "pos": 6,
        "use_uuid": true,
        "options": [
          { "value": "light", "name": "Light" },
          { "value": "dark", "name": "Dark" },
          { "value": "editorial", "name": "Editorial (Off-white)" }
        ],
        "default_value": "editorial",
        "translatable": false,
        "description": "Tema de color base para toda la página."
      },
      "show_header": {
        "type": "boolean",
        "pos": 7,
        "default_value": true,
        "translatable": false
      },
      "show_footer": {
        "type": "boolean",
        "pos": 8,
        "default_value": true,
        "translatable": false
      }
    }
  }
}
